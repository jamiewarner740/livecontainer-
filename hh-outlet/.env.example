# Copy to .env.local and fill in.
DATABASE_URL=postgres://user:password@localhost:5432/hh_outlet

# Payments. Square keys come from the Square Developer dashboard (an app on the owner's Square account).
# SQUARE_ENVIRONMENT=sandbox while testing, production when live.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
# PAYMENTS_PROVIDER=test turns on fake test payments (no money moves). Refused in a production build unless
# ALLOW_TEST_PAYMENTS=yes-this-is-not-the-live-site is also set. Never set either on the live site.
# PAYMENTS_PROVIDER=test

# Shipping under the free-shipping threshold, in cents (e.g. 899 = $8.99). Leave empty to offer pickup only.
SHIPPING_FLAT_RATE_CENTS=
# Sales tax in basis points (700 = 7%). 0 charges no tax; set it once the owner confirms their rate.
TAX_RATE_BPS=0
