# Copy to .env.local and fill in. See README.md for what each one does.
DATABASE_URL=postgres://user:password@localhost:5432/hh_outlet
SITE_URL=https://www.hisnhersllc.com
# 32+ random characters; encrypts stored eBay tokens. Never change it after connecting eBay.
APP_SECRET=
# Uploaded product photos. Must be on a disk that survives restarts.
UPLOAD_DIR=./uploads

# Square (card payments and refunds). sandbox while testing, production when live.
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
# PAYMENTS_PROVIDER=test turns on fake payments (no money moves). Refused in a production build unless
# ALLOW_TEST_PAYMENTS=yes-this-is-not-the-live-site is also set. Never set either on the live site.
# PAYMENTS_PROVIDER=test

# Shipping under the free-shipping threshold, in cents (899 = $8.99). Empty: pickup only under $150.
SHIPPING_FLAT_RATE_CENTS=
# Sales tax in basis points (700 = 7%). 0 charges no tax.
TAX_RATE_BPS=0

# eBay (developer.ebay.com). sandbox while testing, production when live.
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=

# For hosts without a worker process: a scheduler calls GET /api/cron with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Optional extras
ANTHROPIC_API_KEY=
UPCITEMDB_KEY=
